# Copy this file to ".env" (same folder as manage.py) and fill it in. Never commit .env.
#
# Gmail example: turn on 2-Step Verification, then create an "App password"
# at https://myaccount.google.com/apppasswords and paste the 16 characters below.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=yourname@gmail.com
EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop
# Optional:
# DEFAULT_FROM_EMAIL=Bookly <yourname@gmail.com>
# DJANGO_SECRET_KEY=change-me
# DJANGO_DEBUG=1
